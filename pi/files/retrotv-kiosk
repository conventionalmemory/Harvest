#!/bin/bash
CODE=$(cat /etc/retrotv/tv-code 2>/dev/null)
B=/boot/firmware/retrotv-settings.txt
if [ -f "$B" ]; then
  C=$(sed -n 's/^TV_CODE=//p' "$B" | tr -d '\r ' | tr 'a-z' 'A-Z')
  [ -n "$C" ] && CODE="$C"
fi
OS=2
if [ -f "$B" ]; then
  O=$(sed -n 's/^OVERSCAN=//p' "$B" | tr -cd '0-9')
  [ -n "$O" ] && OS="$O"
fi
URL="https://retrotvpi.conventionalmemory.io/?tv=$CODE&os=$OS"
for i in $(seq 1 8); do
  curl -fsS -o /dev/null --max-time 4 "https://retrotvpi.conventionalmemory.io/" && break
  sleep 1
done
BIN=$(command -v chromium || command -v chromium-browser)
LEV=on
DEV=""
TZV=America/Chicago
if [ -f "$B" ]; then
  L=$(sed -n 's/^AUDIO_LEVELER=//p' "$B" | tr -d '\r ' | tr 'A-Z' 'a-z')
  [ -n "$L" ] && LEV="$L"
  DEV=$(sed -n 's/^AUDIO_DEVICE=//p' "$B" | tr -d '\r ')
  Z=$(sed -n 's/^TIMEZONE=//p' "$B" | tr -d '\r ')
  [ -n "$Z" ] && TZV="$Z"
fi
[ -f "/usr/share/zoneinfo/$TZV" ] && export TZ="$TZV"
amixer -q -c Headphones sset PCM 0dB unmute 2>/dev/null || amixer -q sset PCM 0dB unmute 2>/dev/null || true
if [ -z "$DEV" ]; then
  if [ "$LEV" = "off" ]; then C="retrotv_raw retrotv_hw default"; else C="retrotv_dsp retrotv_raw retrotv_hw default"; fi
  for d in $C; do
    if timeout 6 aplay -q -D "$d" -f S16_LE -r 48000 -c 2 -d 1 /dev/zero >/dev/null 2>&1; then DEV="$d"; break; fi
  done
fi
echo "retrotv audio device: ${DEV:-default}"
mkdir -p "$HOME/.cache/retrotv" && echo "${DEV:-default}" > "$HOME/.cache/retrotv/audio" || true
AUD=""
[ -n "$DEV" ] && [ "$DEV" != "default" ] && AUD="--alsa-output-device=$DEV"
export XKB_DEFAULT_LAYOUT=us
PROF=/home/tv/.config/retrotv-chromium
mkdir -p "$PROF"
rm -f "$PROF/SingletonLock" "$PROF/SingletonSocket" "$PROF/SingletonCookie"
sed -i 's/"exited_cleanly":false/"exited_cleanly":true/; s/"exit_type":"[A-Za-z]*"/"exit_type":"Normal"/' "$PROF/Default/Preferences" 2>/dev/null || true
LOGD="$HOME/.cache/retrotv"
mkdir -p "$LOGD"
F=/tmp/retrotv-fails
N=$(cat "$F" 2>/dev/null || echo 0)
echo $((N + 1)) > "$F"
for k in 3 2 1; do [ -f "$LOGD/kiosk-$((k-1)).log" ] && mv -f "$LOGD/kiosk-$((k-1)).log" "$LOGD/kiosk-$k.log"; done
LOG="$LOGD/kiosk-0.log"
EXTRA=""
export WLR_NO_HARDWARE_CURSORS=1
export WLR_LIBINPUT_NO_DEVICES=1
if [ "$N" -ge 2 ]; then export WLR_RENDERER=pixman; EXTRA="--disable-gpu --disable-gpu-compositing"; fi
if [ "$N" -ge 4 ]; then EXTRA="$EXTRA --disable-features=Vulkan,DefaultANGLEVulkan,VulkanFromANGLE --use-gl=disabled"; fi
echo "retrotv start attempt $((N + 1)) renderer=${WLR_RENDERER:-default} extra=$EXTRA" > "$LOG"
( sleep 120; kill -0 $$ 2>/dev/null && echo 0 > "$F" ) &
exec >>"$LOG" 2>&1
exec /usr/bin/cage -s -- "$BIN" --kiosk --noerrdialogs --disable-infobars --no-first-run --disable-session-crashed-bubble --autoplay-policy=no-user-gesture-required --check-for-update-interval=31536000 --disable-features=Translate,MediaRouter,HardwareMediaKeyHandling,AudioServiceSandbox,LocalNetworkAccessChecks,PrivateNetworkAccessSendPreflights,PrivateNetworkAccessRespectPreflightResults --overscroll-history-navigation=0 --disable-pinch --ozone-platform=wayland --enable-features=OverlayScrollbar --user-data-dir="$PROF" --password-store=basic $EXTRA $AUD "file:///usr/local/share/retrotv/wait.html#$(printf %s "$URL" | sed 's/&/%26/g;s/?/%3F/g;s/=/%3D/g')"
