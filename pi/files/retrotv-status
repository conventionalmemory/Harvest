#!/usr/bin/python3
import json, os, re, socket, subprocess, threading, time, urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
ORIGINS = ('https://retrotvpi.conventionalmemory.io', 'https://retrotv.conventionalmemory.io', 'null')
def rd(p, d=None):
    try:
        with open(p) as f: return f.read().strip()
    except Exception: return d
def run(*a):
    try: return subprocess.run(a, capture_output=True, text=True, timeout=3).stdout.strip()
    except Exception: return ''
def fan():
    base = '/sys/class/thermal'
    try:
        for d in sorted(os.listdir(base)):
            if d.startswith('cooling_device') and 'fan' in (rd(os.path.join(base, d, 'type'), '') or '').lower():
                return int(rd(os.path.join(base, d, 'cur_state'), '0') or 0)
    except Exception: pass
    return -1
def wifi():
    t = rd('/proc/net/wireless', '') or ''
    for ln in t.splitlines()[2:]:
        p = ln.split()
        if len(p) >= 4 and p[0].startswith('wlan'):
            try: return int(float(p[3].rstrip('.')))
            except Exception: return -1
    return -1
def status():
    t = rd('/sys/class/thermal/thermal_zone0/temp')
    th = run('vcgencmd', 'get_throttled')
    m = re.search(r'0x([0-9a-fA-F]+)', th)
    thr = int(m.group(1), 16) if m else None
    mem = None
    mi = rd('/proc/meminfo', '') or ''
    m2 = re.search(r'MemAvailable:\s+(\d+)', mi)
    if m2: mem = int(m2.group(1)) // 1024
    up = rd('/proc/uptime', '0 0').split()[0]
    return {'temp': round(int(t) / 1000, 1) if t and t.isdigit() else None, 'thr': (thr & 0x50005) if thr is not None else None, 'fan': fan(), 'wifi': wifi(), 'aud': rd('/home/tv/.cache/retrotv/audio', '') or 'default', 'mem': mem, 'up': int(float(up)), 'img': rd('/etc/retrotv/version', '')}
def netinfo():
    o = {'ssid': '', 'signal': None, 'ip': '', 'eth': False, 'inet': False}
    lk = run('iw', 'dev', 'wlan0', 'link')
    m = re.search(r'SSID: (.+)', lk)
    if m: o['ssid'] = m.group(1).strip()
    m = re.search(r'signal: (-?\d+)', lk)
    if m: o['signal'] = int(m.group(1))
    o['eth'] = (rd('/sys/class/net/eth0/carrier', '0') == '1')
    o['ip'] = (run('hostname', '-I').split() or [''])[0]
    try:
        s = socket.create_connection(('1.1.1.1', 443), timeout=2); s.close(); o['inet'] = True
    except Exception:
        try:
            s = socket.create_connection(('8.8.8.8', 53), timeout=2); s.close(); o['inet'] = True
        except Exception: pass
    return o
class H(BaseHTTPRequestHandler):
    def hdr(self):
        o = self.headers.get('Origin', '')
        if o in ORIGINS: self.send_header('Access-Control-Allow-Origin', o)
        self.send_header('Access-Control-Allow-Private-Network', 'true')
        self.send_header('Access-Control-Allow-Local-Network', 'true')
        self.send_header('Access-Control-Allow-Methods', 'GET')
        self.send_header('Cache-Control', 'no-store')
    def do_OPTIONS(self):
        self.send_response(204); self.hdr(); self.end_headers()
    def do_GET(self):
        pth = self.path.split('?')[0]
        if pth not in ('/status', '/net'):
            self.send_response(404); self.end_headers(); return
        b = json.dumps(status() if pth == '/status' else netinfo()).encode()
        self.send_response(200); self.hdr(); self.send_header('Content-Type', 'application/json'); self.send_header('Content-Length', str(len(b))); self.end_headers(); self.wfile.write(b)
    def log_message(self, *a): pass
RB = 'https://samkpoezeriuurhyrrif.supabase.co/realtime/v1/api/broadcast'
RK = 'sb_publishable_Bqq2ARWOinPrUQ6XegVb_A_BgdPx-XL'
def code():
    c = ''
    try:
        for ln in open('/boot/firmware/retrotv-settings.txt'):
            if ln.startswith('TV_CODE='): c = ln.split('=', 1)[1].strip().upper()
    except Exception: pass
    return c or (rd('/etc/retrotv/tv-code', '') or '')
def report():
    o = {'host_changed': socket.gethostname() != 'retrotv', 'code': code(), 'img': rd('/etc/retrotv/version', '')}
    o.update(status())
    n = netinfo()
    o['net'] = {'wifi': bool(n['ssid']), 'signal': n['signal'], 'eth': n['eth'], 'has_ip': bool(n['ip']), 'inet': n['inet']}
    o['procs'] = [re.sub(r'--user-data-dir=\S+', '', x)[:180] for x in run('pgrep', '-a', '-f', 'cage|chromium').splitlines()[:6]]
    o['journal'] = [x[:220] for x in run('journalctl', '-u', 'retrotv.service', '-b', '-n', '40', '--no-pager', '-o', 'short-monotonic').splitlines()[-40:]]
    try: o['lock'] = os.readlink('/home/tv/.config/retrotv-chromium/SingletonLock').split('-')[-1]
    except Exception: o['lock'] = None
    drm = {}
    try:
        for d in os.listdir('/sys/class/drm'):
            st = rd('/sys/class/drm/%s/status' % d)
            if st: drm[d] = st + '/' + (rd('/sys/class/drm/%s/enabled' % d, '') or '')
    except Exception: pass
    o['drm'] = drm
    o['chromium'] = run('chromium', '--version') or run('chromium-browser', '--version')
    lg = []
    for k in (0, 1):
        t = rd('/home/tv/.cache/retrotv/kiosk-%d.log' % k, '') or ''
        L = [x for x in t.splitlines() if x.strip()]
        lg.append(L[:2] + ['...'] + L[-22:] if len(L) > 26 else L)
    o['kiosk_log'] = [[x[:240] for x in L] for L in lg]
    o['fails'] = rd('/tmp/retrotv-fails', '')
    return o
def beacon():
    while True:
        try:
            b = json.dumps({'messages': [{'topic': 'afterglow-diag', 'event': 'diag', 'payload': {'c': 'PI', 'k': 'pi', 'v': report()}, 'private': False}]}).encode()
            urllib.request.urlopen(urllib.request.Request(RB, data=b, headers={'apikey': RK, 'Content-Type': 'application/json'}), timeout=15).read()
        except Exception: pass
        up = float((rd('/proc/uptime', '0 0') or '0 0').split()[0])
        time.sleep(15 if up < 1500 else 300)
threading.Thread(target=beacon, daemon=True).start()
ThreadingHTTPServer(('127.0.0.1', 8765), H).serve_forever()
