#!/usr/bin/python3
import json, os, re, subprocess, time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
ORIGINS = ('https://retrotvpi.conventionalmemory.io', 'https://retrotv.conventionalmemory.io')
def rd(p, d=None):
    try:
        with open(p) as f: return f.read().strip()
    except Exception: return d
def run(*a):
    try: return subprocess.run(a, capture_output=True, text=True, timeout=3).stdout.strip()
    except Exception: return ''
def fan():
    base = '/sys/class/thermal'
    try:
        for d in sorted(os.listdir(base)):
            if d.startswith('cooling_device') and 'fan' in (rd(os.path.join(base, d, 'type'), '') or '').lower():
                return int(rd(os.path.join(base, d, 'cur_state'), '0') or 0)
    except Exception: pass
    return -1
def wifi():
    t = rd('/proc/net/wireless', '') or ''
    for ln in t.splitlines()[2:]:
        p = ln.split()
        if len(p) >= 4 and p[0].startswith('wlan'):
            try: return int(float(p[3].rstrip('.')))
            except Exception: return -1
    return -1
def status():
    t = rd('/sys/class/thermal/thermal_zone0/temp')
    th = run('vcgencmd', 'get_throttled')
    m = re.search(r'0x([0-9a-fA-F]+)', th)
    thr = int(m.group(1), 16) if m else None
    mem = None
    mi = rd('/proc/meminfo', '') or ''
    m2 = re.search(r'MemAvailable:\s+(\d+)', mi)
    if m2: mem = int(m2.group(1)) // 1024
    up = rd('/proc/uptime', '0 0').split()[0]
    return {'temp': round(int(t) / 1000, 1) if t and t.isdigit() else None, 'thr': (thr & 0x50005) if thr is not None else None, 'fan': fan(), 'wifi': wifi(), 'aud': rd(os.path.expanduser('~/.cache/retrotv/audio'), '') or 'default', 'mem': mem, 'up': int(float(up)), 'img': rd('/etc/retrotv/version', '')}
class H(BaseHTTPRequestHandler):
    def hdr(self):
        o = self.headers.get('Origin', '')
        if o in ORIGINS: self.send_header('Access-Control-Allow-Origin', o)
        self.send_header('Access-Control-Allow-Private-Network', 'true')
        self.send_header('Access-Control-Allow-Local-Network', 'true')
        self.send_header('Access-Control-Allow-Methods', 'GET')
        self.send_header('Cache-Control', 'no-store')
    def do_OPTIONS(self):
        self.send_response(204); self.hdr(); self.end_headers()
    def do_GET(self):
        if self.path.split('?')[0] != '/status':
            self.send_response(404); self.end_headers(); return
        b = json.dumps(status()).encode()
        self.send_response(200); self.hdr(); self.send_header('Content-Type', 'application/json'); self.send_header('Content-Length', str(len(b))); self.end_headers(); self.wfile.write(b)
    def log_message(self, *a): pass
ThreadingHTTPServer(('127.0.0.1', 8765), H).serve_forever()
